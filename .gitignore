.env
.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
# profiles/ and logs/ are machine state: they are regenerated per machine
# and would only add noise here.
profiles/*.json
profiles/runs/
profiles/control/
logs/*.jsonl
/models/

# results/ is the opposite: curated exports from `localpilot report`, kept
# in version control because a measurement nobody can review is not
# evidence.
!results/
!results/*.md
!results/*.json
