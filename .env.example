# Project-local state. Change this when running outside the repository root.
LOCALPILOT_HOME=.

# --- Engine access -----------------------------------------------------
# Point LocalPilot at a server you already run. This is the default path,
# and the safe one: nothing gets downloaded.
# LOCALPILOT_VLLM_BASE_URL=http://127.0.0.1:8000
# LOCALPILOT_TRTLLM_BASE_URL=http://127.0.0.1:8001
# LOCALPILOT_SGLANG_BASE_URL=http://127.0.0.1:8002
# LOCALPILOT_NIM_BASE_URL=http://127.0.0.1:8003
# Applies to any engine without its own variable:
# LOCALPILOT_ENGINE_BASE_URL=http://127.0.0.1:8000

# Let LocalPilot start engines itself. Off by default because starting an
# engine downloads model weights, and one checkpoint here is 328 GB.
# LOCALPILOT_ALLOW_ENGINE_LAUNCH=1
# LOCALPILOT_ENGINE_PORT=8100
# LOCALPILOT_ENGINE_TIMEOUT=900

# --- Quality grading ---------------------------------------------------
# A separate deployment that grades candidate output against a rubric.
# It must not be the candidate's own server: a model cannot certify its
# own answers.
# LOCALPILOT_JUDGE_BASE_URL=http://127.0.0.1:8009
# LOCALPILOT_JUDGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16

# Local weights, for engines that take a path instead of a repo id.
# LOCALPILOT_MODEL_PATH=

# --- API ---------------------------------------------------------------
# Local-only is deliberate.
LOCALPILOT_HOST=127.0.0.1
LOCALPILOT_PORT=8000
